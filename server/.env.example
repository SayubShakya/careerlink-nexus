PORT=5000

# Database (choose one)
# Option 1: Full connection string (Supabase/cloud)
DATABASE_URL=postgresql://user:password@host:port/database

# Option 2: Individual credentials (local)
DB_NAME=your_database_name
DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# JWT Authentication
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=90d

# Environment
NODE_ENV=development